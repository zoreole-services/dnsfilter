#    Each SRV<N> variable describes one Yamu appliance (one set of credentials/protocol/IP), in this fixed field order (comma-separated):
#        YAMU_USER,YAMU_PWD,YAMU_VIEW_NAME,YAMU_API_PROTOCOL,YAMU_SCOPE,YAMU_IPADDR

#    The view_name and scope fields may themselves each hold several
#    values, separated by ";" -- one environment is generated for every
#    combination.


SRV1="XX,XX,XX,XX,XX,XX"
